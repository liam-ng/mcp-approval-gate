{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyDescribe",
      "Effect": "Allow",
      "Action": "ec2:Describe*",
      "Resource": "*"
    },
    {
      "Sid": "RunInstancesCreatedResourcesMustBeTagged",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ca-central-1:035614256871:instance/*",
        "arn:aws:ec2:ca-central-1:035614256871:volume/*",
        "arn:aws:ec2:ca-central-1:035614256871:network-interface/*"
      ],
      "Condition": {
        "Null": { "aws:RequestTag/gateTicketId": "false" }
      }
    },
    {
      "Sid": "RunInstancesReferencedResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:ca-central-1::image/*",
        "arn:aws:ec2:ca-central-1::snapshot/*",
        "arn:aws:ec2:ca-central-1:035614256871:subnet/*",
        "arn:aws:ec2:ca-central-1:035614256871:security-group/*",
        "arn:aws:ec2:ca-central-1:035614256871:key-pair/*"
      ]
    },
    {
      "Sid": "CreateResourcesMustBeTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateKeyPair",
        "ec2:CreateSecurityGroup",
        "ec2:CreateVolume",
        "ec2:CreateSnapshot"
      ],
      "Resource": [
        "arn:aws:ec2:ca-central-1:035614256871:key-pair/*",
        "arn:aws:ec2:ca-central-1:035614256871:security-group/*",
        "arn:aws:ec2:ca-central-1:035614256871:volume/*",
        "arn:aws:ec2:ca-central-1:035614256871:snapshot/*"
      ],
      "Condition": {
        "Null": { "aws:RequestTag/gateTicketId": "false" }
      }
    },
    {
      "Sid": "CreateSecurityGroupReferencedVpc",
      "Effect": "Allow",
      "Action": "ec2:CreateSecurityGroup",
      "Resource": "arn:aws:ec2:ca-central-1:035614256871:vpc/*"
    },
    {
      "Sid": "TagOnCreateOnly",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:aws:ec2:ca-central-1:035614256871:*",
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": [
            "RunInstances",
            "CreateSecurityGroup",
            "CreateVolume",
            "CreateSnapshot",
            "CreateKeyPair",
            "ImportKeyPair"
          ]
        }
      }
    },
    {
      "Sid": "MutateExistingResources",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyInstanceMetadataOptions",
        "ec2:AttachVolume",
        "ec2:DetachVolume",
        "ec2:DeleteVolume",
        "ec2:DeleteSnapshot",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:AllocateAddress",
        "ec2:ReleaseAddress",
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress",
        "ec2:ImportKeyPair",
        "ec2:DeleteKeyPair"
      ],
      "Resource": "arn:aws:ec2:ca-central-1:035614256871:*"
    }
  ]
}