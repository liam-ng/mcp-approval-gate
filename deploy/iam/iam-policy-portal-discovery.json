{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeExistingInfrastructureForThePortalForm",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeVpcs",
        "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeKeyPairs",
        "ec2:DescribeInstances",
        "ec2:DescribeVolumes",
        "ec2:DescribeImages"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ResolveSsmPublicAmiAliases",
      "Effect": "Allow",
      "Action": "ssm:GetParameters",
      "Resource": "arn:aws:ssm:ca-central-1::parameter/aws/service/*"
    }
  ]
}
