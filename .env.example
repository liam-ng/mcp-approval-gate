# Copy to .env for local development. NEVER commit real values.

# --- Human auth ---

ENV=development

# Mandatory. Randomly generated secret.
SESSION_SECRET=local-dev-secret-change-me

# Frontend base URL
PUBLIC_BASE_URL=http://localhost:5173

# Authentication Mode
# dev   -> fake local login, no IdP needed (refused when ENV=production)
# oidc  -> real Authorization Code flow; requires the OIDC_* block below
AUTH_MODE=dev

# Human OIDC — required only when AUTH_MODE=oidc.

# Scenario: AWS, via Amazon Cognito User Pool. Mandatory if AUTH_MODE=oidc.
# Cognito could also add Identity Center as a SAML 2.0 *application* 
#OIDC_ISSUER=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
#OIDC_CLIENT_ID=<client-app-id>
#OIDC_CLIENT_SECRET=<client-app-secret>
#OIDC_SCOPES=openid profile email
#OIDC_GROUPS_CLAIM=cognito:groups
#OIDC_APPROVER_GROUPS=mcp-approver

# Scenario: Azure AD / Entra ID. Mandatory if AUTH_MODE=oidc.
#OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#OIDC_CLIENT_ID=<enterprise-app-clientId>
#OIDC_CLIENT_SECRET=<enterprise-app-clientSecret>
#OIDC_SCOPES=openid profile email
#OIDC_GROUPS_CLAIM=groups
#OIDC_APPROVER_GROUPS=mcp-approver

# Fallback allowlist — needed when there is no IdP's group claims
# Comma-separated emails, always evaluated as approvers alongside OIDC_APPROVER_GROUPS.
APPROVER_EMAILS=you@example.com

# --- Agent auth (IAM SigV4 via presigned sts:GetCallerIdentity) ---

# Always used, independent of AUTH_MODE/OIDC above.
# Mandatory. User-assigned identifier to bind an agent's presigned SigV4 signature to this specific gate deployment, it must appear in SignedHeaders.
GATE_SERVER_ID=mcp-approval-gate-dev

# Mandatory. Should match your AWS IAM role ARN. 
ALLOWED_AGENT_ARNS=arn:aws:iam::123456789012:role/mcp-* 

# --- Workflow ---

REQUIRED_APPROVALS=1
APPROVAL_TTL_HOURS=72

# Off by default -- the four-eyes rule ("approver != proposer") is deliberate.
# Intended for small/solo deployments, not as a routine bypass.
ALLOW_SELF_APPROVAL=false

# --- Storage ---

# MVP default, single-replica PVC, no extra vars needed
STORE_BACKEND=jsonl
DATA_DIR=./data

#STORE_BACKEND=dynamodb  #-> production; requires DYNAMODB_TABLE
#DYNAMODB_TABLE=mcp-approval-gate

#STORE_BACKEND=s3        #-> compliance/WORM via Object Lock; requires S3_BUCKET
#S3_BUCKET=mcp-approval-gate-audit

# Optional with any backend: dual-write audit events to a separate Object Lock (WORM) bucket for compliance-grade retention.
#AUDIT_MIRROR_S3_BUCKET=mcp-approval-gate-audit-mirror

# --- Notifications ---

# If TRUE, requires SES deployment. Sends emails per APPROVER_EMAILS address only, for approval workflow.
# Reusing SESSION_SECRET with a distinct signing salt for link token.
NOTIFY_ON_CREATE=false
#SES_FROM_ADDRESS=mcp-approval-gate@example.com
#SES_REGION=ap-east-1

# --- MCP gateway (IDE clients — Cursor / VS Code — see docs/mcp-gateway.md) ---

# Off by default. When enabled, the backend exposes /mcp as an OAuth2.1 Resource Server: 
# IDE clients run the OAuth flow directly against the IdP below, verifies the bearer token they present.
MCP_ENABLED=false

# Defaults to OIDC_ISSUER above if unset; only set this if IDE clients must
# authenticate against a different Authorization Server.
#MCP_OAUTH_ISSUER=

# Strongly recommended once MCP_ENABLED=true — without it, any token from
# the same issuer for ANY client is accepted.

# openid/email/profile are Cognito's built-in standard scopes
# Without `email` here, Cursor never requests it and userinfo comes back without an email claim.
#MCP_REQUIRED_SCOPES=openid email profile

# The trusted identity that executes MCP-created tickets once approved.
# Must also appear in ALLOWED_AGENT_ARNS above.
# Also required by the portal's own create form (POST /api/tickets), which is
# NOT gated on MCP_ENABLED — without this set, that form returns 503 rather
# than opening a ticket nothing would ever execute.
#MCP_EXECUTOR_ARN=arn:aws:iam::123456789012:role/mcp-approval-gate-executor


# --- Read-only AWS discovery for the portal's create form (optional) ---------
# OFF BY DEFAULT, and the default is the safe one: with this unset the gate
# holds no AWS credentials at all — the posture CLAUDE.md's "the gate needs no
# AWS permissions" invariant describes. Turning it on buys real subnet / AMI /
# security-group / key-pair pickers in the form instead of typed-in ids, and it
# lets the form resolve `resolve:ssm:/aws/service/...` AMI aliases to a
# concrete ami- so the approver reviews the image that will actually launch.
#
# The identity MUST be a separate, Describe-only role — never the executor's.
# See deploy/iam/portal-discovery-inline-policy.json for the permissions and
# deploy/iam/irsa-portal-discovery-trust-policy.json for the trust.
# Every endpoint degrades to "type the id yourself" on any failure, so a
# missing permission is a mild annoyance, not an outage.
#AWS_DISCOVERY_ENABLED=false
# Unset = use the ambient credential chain (IRSA on EKS). Set it where the pod
# holds a source credential and must step into the discovery role instead.
#AWS_DISCOVERY_ROLE_ARN=arn:aws:iam::123456789012:role/mcp-approval-gate-portal-discovery
#AWS_DISCOVERY_DEFAULT_REGION=ca-central-1
#AWS_DISCOVERY_CACHE_SECONDS=300
