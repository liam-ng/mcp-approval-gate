# Copy to .env for local development. NEVER commit real values.

# dev = fake local login (refused when ENV=production)
ENV=development
AUTH_MODE=dev
SESSION_SECRET=local-dev-secret-change-me
PUBLIC_BASE_URL=http://localhost:8000

# Human OIDC (required when AUTH_MODE=oidc)
#OIDC_ISSUER=https://identitycenter.amazonaws.com/ssoins-XXXX
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid profile email
#OIDC_GROUPS_CLAIM=groups
#OIDC_APPROVER_GROUPS=aws-approvers
APPROVER_EMAILS=you@example.com

# Agent auth
GATE_SERVER_ID=mcp-approval-gate-dev
ALLOWED_AGENT_ARNS=arn:aws:iam::123456789012:role/mcp-*

# Workflow
REQUIRED_APPROVALS=1
APPROVAL_TTL_HOURS=72

# Storage
STORE_BACKEND=jsonl
DATA_DIR=./data

# Notifications
NOTIFY_ON_CREATE=false
#SES_FROM_ADDRESS=approval-gate@example.com
#SES_REGION=ap-east-1
