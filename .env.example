# Copy to .env for local development. NEVER commit real values.

# --- Human auth ---
# AUTH_MODE=dev   -> fake local login, no IdP needed (refused when ENV=production)
# AUTH_MODE=oidc  -> real Authorization Code flow; requires the OIDC_* block below
ENV=development
AUTH_MODE=dev
SESSION_SECRET=local-dev-secret-change-me
PUBLIC_BASE_URL=http://localhost:8000

# Human OIDC — required only when AUTH_MODE=oidc.
# Provider-agnostic: point these at any OIDC IdP without code changes.

# Scenario: AUTH_MODE=oidc with IAM Identity Center
#OIDC_ISSUER=https://identitycenter.amazonaws.com/ssoins-XXXX
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid profile email
#OIDC_GROUPS_CLAIM=groups
#OIDC_APPROVER_GROUPS=aws-approvers

# Scenario: AUTH_MODE=oidc with Azure AD / Entra ID (swap-in, same code path)
#OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid profile email
#OIDC_GROUPS_CLAIM=groups
#OIDC_APPROVER_GROUPS=aws-approvers

# Fallback allowlist — needed if your IdP's group claims are weak/absent
# (e.g. IAM Identity Center). Comma-separated emails, always evaluated
# alongside OIDC_APPROVER_GROUPS regardless of provider.
APPROVER_EMAILS=you@example.com

# --- Agent auth (IAM SigV4 via presigned sts:GetCallerIdentity) ---
# Always used, independent of AUTH_MODE/OIDC above.
GATE_SERVER_ID=mcp-approval-gate-dev
ALLOWED_AGENT_ARNS=arn:aws:iam::123456789012:role/mcp-*

# --- Workflow ---
REQUIRED_APPROVALS=1
APPROVAL_TTL_HOURS=72

# --- Storage ---
# MVP default, single-replica PVC, no extra vars needed
STORE_BACKEND=jsonl
DATA_DIR=./data

#STORE_BACKEND=dynamodb  -> production; requires DYNAMODB_TABLE
#DYNAMODB_TABLE=mcp-approval-gate

#STORE_BACKEND=s3        -> compliance/WORM via Object Lock; requires S3_BUCKET
#S3_BUCKET=mcp-approval-gate-audit

# Optional with any backend: dual-write audit events to a separate
# Object Lock (WORM) bucket for compliance-grade retention.
#AUDIT_MIRROR_S3_BUCKET=mcp-approval-gate-audit-mirror

# --- Notifications ---
# NOTIFY_ON_CREATE=true requires SES_FROM_ADDRESS and SES_REGION
NOTIFY_ON_CREATE=false
#SES_FROM_ADDRESS=approval-gate@example.com
#SES_REGION=ap-east-1

# --- MCP gateway (IDE clients — Cursor / VS Code — see docs/mcp-gateway.md) ---
# Off by default. When enabled, the gate exposes /mcp as an OAuth2.1 Resource
# Server: IDE clients run the OAuth flow directly against the IdP below, the
# gate only verifies the bearer token they present.
MCP_ENABLED=false
# Defaults to OIDC_ISSUER above if unset; only set this if IDE clients must
# authenticate against a different Authorization Server.
#MCP_OAUTH_ISSUER=
# Strongly recommended once MCP_ENABLED=true — without it, any token from
# the same issuer for ANY client is accepted.
#MCP_OAUTH_AUDIENCE=
#MCP_REQUIRED_SCOPES=mcp:invoke
# The trusted identity that executes MCP-created tickets once approved
# (docs/agent-contract.md). Must also appear in ALLOWED_AGENT_ARNS above.
#MCP_EXECUTOR_ARN=arn:aws:iam::123456789012:role/mcp-approval-gate-executor
